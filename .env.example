# Client-side (safe to expose): Supabase project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Vercel server env + Edge Function secrets — never in
# client bundles, never committed. Required by scripts/seed-first-admin.ts
# and privileged Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=
